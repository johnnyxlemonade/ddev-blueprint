# Example local environment values.
# Store application credentials in an ignored local file.
APP_ENV=development

# Standard DDEV MariaDB/MySQL connection.
DB_HOST=db
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=db

# Redis from docker-compose.redis.yaml.
REDIS_HOST=redis
REDIS_PORT=6379

# OpenTelemetry Collector from docker-compose.otel.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
